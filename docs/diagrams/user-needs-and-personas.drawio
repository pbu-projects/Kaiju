        <mxCell id="cell_24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 9 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;dispatch authentic, personalized gratitude and shared community impact metrics within hours of shift completion&lt;/b&gt; in order to foster emotional connection and transform one-time volunteers into reliable recurring team members.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#581c87;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;dispatch personalized gratitude and impact metrics&#39;&lt;/i&gt;. Deepens Relatedness; turns labor into community.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="927" as="geometry" />
        </mxCell>
        <mxCell id="cell_25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#581c87;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 10 (Marcus &amp;bull; Volunteer):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Marcus needs to &lt;b&gt;see the tangible community outcome of his completed service and effortlessly reserve a spot for a future shift&lt;/b&gt; in order to feel that his personal sacrifice created genuine human value.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#581c87;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;see tangible outcome and reserve next shift&#39;&lt;/i&gt;. Closes the viral retention loop.&lt;/font&gt;" vertex="1">
