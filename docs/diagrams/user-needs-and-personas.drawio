<mxfile host="Electron" agent="Antigravity">
  <diagram id="kaiju_user_needs_personas" name="NNg-User-Needs-and-Personas">
    <mxGraphModel dx="2357" dy="1402" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cell_2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=22;fontStyle=1;" value="&lt;b&gt;KAIJU PLATFORM — USER PERSONAS &amp;amp; HUMAN NEED STATEMENTS&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size: 13px; font-weight: normal; color: #475569;&#39;&gt;Grounded in Nielsen Norman Group (NN/g) Research: Behavioral Persona Archetypes &amp;bull; Verb-Driven User Need Statements &amp;bull; Self-Determination Theory&lt;br/&gt;Core Human Domain: Volunteer Roster Management, Shift Deficit Resolution, Targeted Communication &amp;amp; Follow-up&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1500" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="cell_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;fontColor=#1e293b;align=left;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;NN/g NEED STATEMENT FORMULA &amp;amp; PSYCHOLOGICAL PILLARS&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Formula:&lt;/b&gt; &lt;i&gt;[User/Persona]&lt;/i&gt; needs &lt;b&gt;[verb-driven need]&lt;/b&gt; in order to &lt;b&gt;[human goal/insight]&lt;/b&gt;.&lt;br/&gt;&lt;span style=&#39;color: #3b82f6;&#39;&gt;&amp;#9632;&lt;/span&gt; &lt;b&gt;Autonomy:&lt;/b&gt; Choice, control, frictionless action | &lt;span style=&#39;color: #22c55e;&#39;&gt;&amp;#9632;&lt;/span&gt; &lt;b&gt;Competence:&lt;/b&gt; Preparedness, mastery, verified proof&lt;br/&gt;&lt;span style=&#39;color: #a855f7;&#39;&gt;&amp;#9632;&lt;/span&gt; &lt;b&gt;Relatedness:&lt;/b&gt; Warmth, community belonging, authentic human appreciation" vertex="1">
          <mxGeometry height="75" width="760" x="1560" y="30" as="geometry" />
        </mxCell>
        <mxCell id="cell_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;arcSize=8;shadow=1;" value="&lt;b&gt;1. RESEARCH-BACKED PERSONAS&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;color:#94a3b8;&#39;&gt;Behaviors, Context, Motivations &amp;amp; Frictions&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="680" x="40" y="125" as="geometry" />
        </mxCell>
        <mxCell id="cell_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;arcSize=8;shadow=1;" value="&lt;b&gt;2. OPERATIONAL DOMAIN&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;color:#94a3b8;&#39;&gt;Core Volunteer Management Themes&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="380" x="750" y="125" as="geometry" />
        </mxCell>
        <mxCell id="cell_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;arcSize=8;shadow=1;" value="&lt;b&gt;3. NN/g USER NEED STATEMENTS (VERBS &amp;bull; NOT NOUNS)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;font-size:11px;font-weight:normal;color:#94a3b8;&#39;&gt;[User] needs [Action Verb] in order to [Human Insight / Goal]&lt;/font&gt;" vertex="1">
          <mxGeometry height="55" width="1160" x="1160" y="125" as="geometry" />
        </mxCell>
        <mxCell id="cell_7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;fontColor=#0c4a6e;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;arcSize=6;shadow=1;" value="&lt;b&gt;SARAH LIN &amp;bull; &lt;i&gt;The Overwhelmed Grassroots Coordinator&lt;/i&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;color: #0284c7; font-weight: bold;&#39;&gt;Role:&lt;/font&gt; Project Coordinator (`ORG_MANAGER`) &amp;bull; &lt;i&gt;Urban Harvest Food Pantry&lt;/i&gt; (Grassroots 501c3)&lt;br/&gt;&lt;font style=&#39;color: #0f172a;&#39;&gt;&lt;i&gt;&amp;ldquo;I spend more time chasing unconfirmed volunteers on spreadsheets and sending individual text messages than I do actually running our food distribution.&amp;rdquo;&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Context &amp;amp; Environment:&lt;/b&gt;&lt;br/&gt;&amp;bull; Manages 8–10 shifts/week with 12–20 volunteers each across 2 physical warehouse sites.&lt;br/&gt;&amp;bull; Works under high operational stress; understaffed shifts mean fresh food spoils or boxes go unpacked.&lt;br/&gt;&amp;bull; Juggles a broken laptop at a desk and a mobile phone on wet, noisy staging docks.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Current Behaviors &amp;amp; Hacks:&lt;/b&gt;&lt;br/&gt;&amp;bull; Maintains a color-coded Google Sheet that breaks when multi-edited.&lt;br/&gt;&amp;bull; Sends BCC mass emails that get caught in spam filters; manually texts volunteers from personal cell phone.&lt;br/&gt;&amp;bull; Scrambles Friday evening at 8 PM to send panic texts: &lt;i&gt;&#39;Are you still coming tomorrow?&#39;&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Core Motivations (Self-Determination Theory):&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Autonomy:&lt;/b&gt; Reclaim operational control over staffing without working 70-hour manual weeks.&lt;br/&gt;&amp;bull; &lt;b&gt;Competence:&lt;/b&gt; Deliver reliable, 100% staffed community shifts with zero last-minute crises.&lt;br/&gt;&amp;bull; &lt;b&gt;Relatedness:&lt;/b&gt; Cultivate a warm, loyal core community of volunteers who feel seen and valued.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Frictions &amp;amp; Anxieties:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Spreadsheet Blindness:&lt;/b&gt; Discovering a Saturday morning shift is only 30% filled at 9 PM on Friday.&lt;br/&gt;&amp;bull; &lt;b&gt;The 40% Ghosting Rate:&lt;/b&gt; Volunteers register weeks in advance, forget, and silently fail to show up.&lt;br/&gt;&amp;bull; &lt;b&gt;Post-Shift Exhaustion:&lt;/b&gt; Lack of time to send follow-up thank-yous, causing valuable volunteers to drift away." vertex="1">
          <mxGeometry height="370" width="680" x="40" y="195" as="geometry" />
        </mxCell>
        <mxCell id="cell_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=2;fontColor=#312e81;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;arcSize=6;shadow=1;" value="&lt;b&gt;MARCUS VANCE &amp;bull; &lt;i&gt;The Purpose-Driven Professional&lt;/i&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;color: #4f46e5; font-weight: bold;&#39;&gt;Role:&lt;/font&gt; Community Volunteer (`VOLUNTEER`) &amp;bull; 32, UX Consultant &amp;bull; Volunteers 1–2 Saturdays/month&lt;br/&gt;&lt;font style=&#39;color: #0f172a;&#39;&gt;&lt;i&gt;&amp;ldquo;I genuinely want to help my local neighborhood, but if I don&#39;t know where to park, what to wear, or who to look for, the anxiety makes me want to stay home.&amp;rdquo;&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Context &amp;amp; Environment:&lt;/b&gt;&lt;br/&gt;&amp;bull; Demanding corporate job during the week; volunteers on weekends to reconnect with purpose.&lt;br/&gt;&amp;bull; Mobile-only lifestyle outside work hours; rarely checks personal desktop email on weekends.&lt;br/&gt;&amp;bull; Values punctuality, clear expectations, and respect for his personal time.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Current Behaviors &amp;amp; Hacks:&lt;/b&gt;&lt;br/&gt;&amp;bull; Signs up for shifts 2–3 weeks ahead, but searches his inbox 30 mins before departure for address details.&lt;br/&gt;&amp;bull; Feels deeply guilty when personal conflicts arise, but hates making phone calls to cancel, leading to ghosting.&lt;br/&gt;&amp;bull; Prefers direct text/SMS communications over bloated portal apps.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Core Motivations (Self-Determination Theory):&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Autonomy:&lt;/b&gt; Flexibility to pick convenient, impactful shifts and manage his commitments friction-free.&lt;br/&gt;&amp;bull; &lt;b&gt;Competence:&lt;/b&gt; Arrive on site knowing exactly what to do, what gear to bring, and how his effort helped.&lt;br/&gt;&amp;bull; &lt;b&gt;Relatedness:&lt;/b&gt; Experience tangible human connection with local organizers and fellow neighbors.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Frictions &amp;amp; Anxieties:&lt;/b&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Logistical Fog:&lt;/b&gt; Vague listings with no parking details, gate codes, or footwear requirements.&lt;br/&gt;&amp;bull; &lt;b&gt;Arrival Isolation:&lt;/b&gt; Showing up at an unfamiliar site and wandering around looking for someone in charge.&lt;br/&gt;&amp;bull; &lt;b&gt;The Recognition Void:&lt;/b&gt; Leaving after 4 hours of intense physical labor and never hearing a single word of follow-up." vertex="1">
          <mxGeometry height="370" width="680" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="cell_9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#c026d3;strokeWidth=2;fontColor=#701a75;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;arcSize=6;shadow=1;" value="&lt;b&gt;ELENA RODRIGUEZ &amp;bull; &lt;i&gt;The Milestone &amp;amp; Credit Seeker&lt;/i&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;color: #c026d3; font-weight: bold;&#39;&gt;Role:&lt;/font&gt; Student Volunteer (`VOLUNTEER`) &amp;bull; 17, High School Senior &amp;bull; Needs 40 certified service hours&lt;br/&gt;&lt;font style=&#39;color: #0f172a;&#39;&gt;&lt;i&gt;&amp;ldquo;I completed 16 hours last month, but the paper slip got soaked in the rain, and the coordinator hasn&#39;t replied to my emails to sign a new one.&amp;rdquo;&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Context:&lt;/b&gt; Strictly smartphone-based (SMS, Instagram, TikTok); needs certified hours for graduation and scholarships.&lt;br/&gt;&lt;b&gt;Frictions:&lt;/b&gt; Paper verification sheets getting lost or ruined; coordinators taking weeks to sign verification letters.&lt;br/&gt;&lt;b&gt;Goal:&lt;/b&gt; Immediate, verifiable, tamper-proof digital proof of completed service hours." vertex="1">
          <mxGeometry height="160" width="680" x="40" y="965" as="geometry" />
        </mxCell>
        <mxCell id="cell_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#064e3b;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;arcSize=6;shadow=1;" value="&lt;b&gt;DAVID O&#39;CONNOR &amp;bull; &lt;i&gt;The Boots-on-the-Ground Field Lead&lt;/i&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&#39;color: #059669; font-weight: bold;&#39;&gt;Role:&lt;/font&gt; Volunteer Site Captain (`ORG_MEMBER`) &amp;bull; Veteran Volunteer designated as site lead&lt;br/&gt;&lt;font style=&#39;color: #0f172a;&#39;&gt;&lt;i&gt;&amp;ldquo;When 15 people arrive at a muddy park at 8:00 AM, I need to know in 10 seconds who is here and who has allergies—without clipboards in the rain.&amp;rdquo;&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Context:&lt;/b&gt; Coordinates volunteers on site while Sarah manages the pantry warehouse.&lt;br/&gt;&lt;b&gt;Frictions:&lt;/b&gt; Illegible paper sign-in handwriting; not knowing if missing volunteers are running 10 mins late or ghosting.&lt;br/&gt;&lt;b&gt;Goal:&lt;/b&gt; 10-second mobile check-in and instantaneous headcount visibility in harsh field conditions." vertex="1">
          <mxGeometry height="160" width="680" x="40" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="cell_11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;THEME 1: SHIFT DEFICIT AUDIT &amp;amp; CAPACITY REVIEW&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Operational Focus:&lt;/b&gt;&lt;br/&gt;&amp;bull; Evaluating upcoming shift fill rates against minimum thresholds.&lt;br/&gt;&amp;bull; Distinguishing critical role gaps (Lead, Driver) from general count.&lt;br/&gt;&amp;bull; Detecting staffing risks 5–7 days in advance rather than night-before." vertex="1">
          <mxGeometry height="175" width="380" x="750" y="195" as="geometry" />
        </mxCell>
        <mxCell id="cell_12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;THEME 2: TARGETED DISPATCH &amp;amp; URGENT COMMUNICATION&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Operational Focus:&lt;/b&gt;&lt;br/&gt;&amp;bull; Reaching qualified, nearby candidate pools via SMS/Push.&lt;br/&gt;&amp;bull; Frictionless 1-click slot claiming without password barriers.&lt;br/&gt;&amp;bull; Preventing broadcast spam fatigue across the community." vertex="1">
          <mxGeometry height="175" width="380" x="750" y="385" as="geometry" />
        </mxCell>
        <mxCell id="cell_13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;THEME 3: PRE-SHIFT BRIEFING &amp;amp; RSVP CONFIRMATION&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Operational Focus:&lt;/b&gt;&lt;br/&gt;&amp;bull; Delivering actionable logistics (parking, attire, weather, lead contact).&lt;br/&gt;&amp;bull; 2-way SMS RSVP (Confirm / Cancel) to mitigate ghosting.&lt;br/&gt;&amp;bull; Automated waitlist promotion cascade upon early cancellation." vertex="1">
          <mxGeometry height="175" width="380" x="750" y="575" as="geometry" />
        </mxCell>
        <mxCell id="cell_14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;THEME 4: LIVE ON-SITE ATTENDANCE &amp;amp; FIELD VERIFICATION&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Operational Focus:&lt;/b&gt;&lt;br/&gt;&amp;bull; Rapid digital check-in (QR pass / PostGIS geofence).&lt;br/&gt;&amp;bull; Real-time headcount reconciliation; late-arrival SMS ping.&lt;br/&gt;&amp;bull; Replacing paper clipboards and manual roster tallies." vertex="1">
          <mxGeometry height="175" width="380" x="750" y="765" as="geometry" />
        </mxCell>
        <mxCell id="cell_15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontColor=#1e293b;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;THEME 5: POST-SHIFT RECOGNITION &amp;amp; VIRAL RETENTION&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Operational Focus:&lt;/b&gt;&lt;br/&gt;&amp;bull; Personalized appreciation message from coordinator within hours.&lt;br/&gt;&amp;bull; Verifiable, tamper-proof digital service hours certificate.&lt;br/&gt;&amp;bull; Micro-feedback and 1-tap booking loop for upcoming shifts." vertex="1">
          <mxGeometry height="175" width="380" x="750" y="955" as="geometry" />
        </mxCell>
        <mxCell id="cell_16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 1 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;evaluate real-time shift capacity fill rates against minimum staffing thresholds days in advance&lt;/b&gt; in order to proactively identify critical service shortages before community operations are compromised.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#1e3a8a;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on the verb &lt;i&gt;&#39;evaluate fill rates&#39;&lt;/i&gt;, not a dashboard widget. Satisfies Autonomy by granting proactive operational control.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="195" as="geometry" />
        </mxCell>
        <mxCell id="cell_17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 2 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;distinguish between specialized role shortages (drivers, bilingual leads) and general headcount needs&lt;/b&gt; in order to target recruitment efforts toward specific qualifications rather than blasting generic requests.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#14532d;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;distinguish role shortages&#39;&lt;/i&gt;. Satisfies Competence by ensuring qualified role coverage.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="283" as="geometry" />
        </mxCell>
        <mxCell id="cell_18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 3 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;broadcast high-urgency, contextual outreach across mobile channels (SMS/WhatsApp) to nearby qualified candidate pools&lt;/b&gt; in order to fill empty slots quickly without fatiguing her broader community with irrelevant blasts.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#1e3a8a;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;broadcast contextual outreach&#39;&lt;/i&gt;. Eliminates spreadsheet phone tag; protects community goodwill.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="378" as="geometry" />
        </mxCell>
        <mxCell id="cell_19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 4 (Marcus &amp;bull; Volunteer):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Marcus needs to &lt;b&gt;claim an open shift slot or release an existing commitment with a single frictionless mobile tap&lt;/b&gt; in order to manage his civic schedule responsibly without guilt or cumbersome authentication barriers.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#1e3a8a;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;claim or release with single tap&#39;&lt;/i&gt;. Removes cognitive friction; treats volunteer as an efficient human.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="466" as="geometry" />
        </mxCell>
        <mxCell id="cell_20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 5 (Marcus &amp;bull; Volunteer):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Marcus needs to &lt;b&gt;receive concise, timely arrival instructions (parking, attire, weather, site lead) on his mobile device 24–48 hours prior to a shift&lt;/b&gt; in order to feel confident, adequately prepared, and calm on event morning.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#14532d;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;receive arrival instructions&#39;&lt;/i&gt;. Satisfies Competence and psychological safety; eliminates logistical fog.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="561" as="geometry" />
        </mxCell>
        <mxCell id="cell_21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 6 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;obtain definitive attendance confirmations and automatically backfill cancellations from a waitlist&lt;/b&gt; in order to prevent silent volunteer ghosting and avoid fielding understaffed operations.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#1e3a8a;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;obtain confirmations and backfill cancellations&#39;&lt;/i&gt;. Replaces manual scramble with automated safety nets.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="649" as="geometry" />
        </mxCell>
        <mxCell id="cell_22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;fontColor=#14532d;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 7 (David &amp;bull; Field Lead):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;David needs to &lt;b&gt;verify volunteer arrivals in seconds using mobile field tools and access critical emergency contacts instantly&lt;/b&gt; in order to start operations on time and protect volunteer safety under field conditions.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#14532d;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;verify arrivals in seconds&#39;&lt;/i&gt;. Cuts check-in from minutes to seconds; protects duty of care.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="744" as="geometry" />
        </mxCell>
        <mxCell id="cell_23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e3a8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=6;" value="&lt;b&gt;NEED STATEMENT 8 (Sarah &amp;bull; Coordinator):&lt;/b&gt;&lt;br/&gt;&amp;ldquo;Sarah needs to &lt;b&gt;detect delayed volunteers within 15 minutes of shift start and dispatch a one-tap check-in nudge&lt;/b&gt; in order to distinguish between delayed participants and true no-shows before making emergency reallocations.&amp;rdquo;&lt;br/&gt;&lt;font style=&#39;font-size:10px;color:#1e3a8a;&#39;&gt;&lt;b&gt;NN/g Insight:&lt;/b&gt; Focuses on &lt;i&gt;&#39;detect delayed volunteers and dispatch check-in nudge&#39;&lt;/i&gt;. Provides real-time field visibility.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1140" x="1170" y="832" as="geometry" />
