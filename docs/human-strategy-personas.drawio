  <diagram id="page_1_ecosystem" name="1. Human Strategy Ecosystem">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_1_ecosystem_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_3" parent="1" value="KAIJU (VOLUNTEER MONSTER) — COMPREHENSIVE HUMAN STRATEGY ECOSYSTEM" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="32" width="950" height="26" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_4" parent="1" value="The Complete Spectrum: Spontaneous, Skilled, Academic &amp; Mandated Volunteers | High-Volume vs High-Liability Non-Profits (NN/g Framework)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=11;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="58" width="950" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_5" parent="1" value="NN/g Standard: 7 Proto-Personas &amp; 4-Quadrant Empathy Maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;fontSize=10;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1080" y="34" width="460" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_6" parent="1" value="Architecture: PostGIS 17 + JTE + Compose + Micronaut Security RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=10;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1080" y="62" width="460" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_7" parent="1" value="THE VOLUNTEER SPECTRUM: 4 DISTINCT HUMAN MOTIVATIONS" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="50" y="85" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_8" parent="1" value="&lt;b&gt;MAYA LIN (24) — SPONTANEOUS LOCAL&lt;/b&gt;&lt;br/&gt;&lt;font color='#ea580c'&gt;Role: STANDARD_USER (Public Searcher)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Motivation:&lt;/b&gt; Quick 2-3 hr local impact on weekends.&lt;br/&gt;• &lt;b&gt;Friction:&lt;/b&gt; App downloads, logins, 8s load times.&lt;br/&gt;• &lt;b&gt;Key Need:&lt;/b&gt; Sub-50ms search &amp; OPEN_DOOR walk-ins.&lt;br/&gt;• &lt;b&gt;Stack:&lt;/b&gt; JTE SSR + ST_DWithin + ProjectSearchCard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="50" y="108" width="355" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_9" parent="1" value="&lt;b&gt;DAVID CHEN (31) — PURPOSE &amp; SKILL-BUILDING&lt;/b&gt;&lt;br/&gt;&lt;font color='#0284c7'&gt;Role: STANDARD_USER (Specialist)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Motivation:&lt;/b&gt; Professional skill use (GIS/data) &amp; causes.&lt;br/&gt;• &lt;b&gt;Friction:&lt;/b&gt; Generic distance search, manual busywork.&lt;br/&gt;• &lt;b&gt;Key Need:&lt;/b&gt; Skill/cause taxonomy &amp; regional initiatives.&lt;br/&gt;• &lt;b&gt;Stack:&lt;/b&gt; tags/shift_tags + REGIONAL STI + Passport." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="425" y="108" width="355" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_10" parent="1" value="&lt;b&gt;CHLOE TORRES (17) — ACADEMIC &amp; PORTFOLIO&lt;/b&gt;&lt;br/&gt;&lt;font color='#0d9488'&gt;Role: STANDARD_USER (Student / Club Officer)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Motivation:&lt;/b&gt; College/NHS 100-hr service requirement.&lt;br/&gt;• &lt;b&gt;Friction:&lt;/b&gt; Lost paper logs, unverified hours, group booking.&lt;br/&gt;• &lt;b&gt;Key Need:&lt;/b&gt; Verified PDF transcript &amp; group holds.&lt;br/&gt;• &lt;b&gt;Stack:&lt;/b&gt; Service Ledger + Group Reservations + Digital Waivers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="800" y="108" width="355" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_11" parent="1" value="&lt;b&gt;RAYMOND MILLER (35) — MANDATED &amp; COMPLIANCE&lt;/b&gt;&lt;br/&gt;&lt;font color='#b45309'&gt;Role: STANDARD_USER (Court / SNAP Work)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Motivation:&lt;/b&gt; Complete court hours &amp; preserve SNAP food aid.&lt;br/&gt;• &lt;b&gt;Friction:&lt;/b&gt; Rejected on arrival, probation deadlines, lost slips.&lt;br/&gt;• &lt;b&gt;Key Need:&lt;/b&gt; Court/SNAP eligibility filters &amp; timestamped log.&lt;br/&gt;• &lt;b&gt;Stack:&lt;/b&gt; Compliance Flags + Audit Ledger + Court PDF Export." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="1175" y="108" width="355" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_12" parent="1" value="THE COORDINATOR &amp; CIVIC GOVERNANCE SPECTRUM: 3 OPERATIONAL LEADERS" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="50" y="252" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_13" parent="1" value="&lt;b&gt;MARCUS VANCE (38) — HIGH-VOLUME OPERATIONS COORDINATOR&lt;/b&gt;&lt;br/&gt;&lt;font color='#059669'&gt;Role: ORG_ADMIN / ORG_MANAGER (Food Bank / Cleanups)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Focus:&lt;/b&gt; Filling shift capacities, multi-site logistics across 5 hubs.&lt;br/&gt;• &lt;b&gt;Core Pain:&lt;/b&gt; 30-50% volunteer no-shows, duplicate event creation, clipboard chaos.&lt;br/&gt;• &lt;b&gt;Stack Alignment:&lt;/b&gt; Compose Multiplatform Admin + project_locations + /no-look Ingestion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="50" y="275" width="480" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_14" parent="1" value="&lt;b&gt;DR. SARAH AL-MANSOOR (42) — HIGH-LIABILITY PROGRAM DIRECTOR&lt;/b&gt;&lt;br/&gt;&lt;font color='#9333ea'&gt;Role: ORG_ADMIN (Youth Shelters &amp; Crisis Lines)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Focus:&lt;/b&gt; Youth safeguarding, background check vetting, 40h crisis training.&lt;br/&gt;• &lt;b&gt;Core Pain:&lt;/b&gt; Unvetted public walk-ins, lapsed credentials, catastrophic liability.&lt;br/&gt;• &lt;b&gt;Stack Alignment:&lt;/b&gt; Gated Shift Rosters + Vetting APIs + Credential Expiration Tracking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="555" y="275" width="480" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_15" parent="1" value="&lt;b&gt;ELENA ROSTOVA (45) — CIVIC REGIONAL MODERATOR&lt;/b&gt;&lt;br/&gt;&lt;font color='#1d4ed8'&gt;Role: REGION_DIRECTOR / REGION_AGENT (County Governance)&lt;/font&gt;&lt;hr style='margin:3px 0;'/&gt;• &lt;b&gt;Focus:&lt;/b&gt; Municipal safety oversight, territorial boundaries, 48-hour SLA queues.&lt;br/&gt;• &lt;b&gt;Core Pain:&lt;/b&gt; Review bottlenecks, ambiguous borders, unauthorized post-approval edits.&lt;br/&gt;• &lt;b&gt;Stack Alignment:&lt;/b&gt; administrative_regions (DDD) + 48h Escalation Queue + Audit Ledgers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;align=left;verticalAlign=top;spacing=6;fontSize=9;fontColor=#1e293b;" vertex="1"><mxGeometry x="1060" y="275" width="480" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_16" parent="1" value="TECHNICAL ARCHITECTURE &amp; SERVICE DECOUPLING" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="50" y="412" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_17" parent="1" value="&lt;b&gt;CLIENT PRESENTATION LAYER&lt;/b&gt; (Targeted Specialization across User Types)" style="swimlane;startSize=22;fontStyle=1;align=center;verticalAlign=top;fontSize=10;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="50" y="435" width="1500" height="95" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_18" parent="c_page_1_ecosystem_14" value="&lt;b&gt;Public Web Explorer (JTE SSR)&lt;/b&gt;&lt;br/&gt;• Sub-50ms TTFB &amp; 0MB JS Bundle&lt;br/&gt;• Crawlable HTML SEO for search engines&lt;br/&gt;• Serves Maya (Local), David (Skills), &amp; Raymond (Compliance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f97316;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="20" y="30" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_19" parent="c_page_1_ecosystem_14" value="&lt;b&gt;Admin Dashboard (Compose Multiplatform)&lt;/b&gt;&lt;br/&gt;• Rich desktop-grade shift builders &amp; calendar drag-and-drop&lt;br/&gt;• Bulk CSV imports, capacity controls, &amp; vetting queues&lt;br/&gt;• Serves Marcus (Operations) &amp; Dr. Sarah (Safeguarding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="520" y="30" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_20" parent="c_page_1_ecosystem_14" value="&lt;b&gt;Mobile Volunteer &amp; Student Portal&lt;/b&gt;&lt;br/&gt;• Shared Kotlin Multiplatform core (Android, iOS, Desktop)&lt;br/&gt;• Digital QR ticket check-in &amp; verified service hour credentials&lt;br/&gt;• Serves Chloe (Club Roster/Hours) &amp; Volunteers (Notifications)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="1020" y="30" width="460" height="55" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_21" parent="1" value="&lt;b&gt;CORE DOMAIN SERVICES &amp; WORKFLOW ENGINES&lt;/b&gt; (Micronaut 5 + Java 25 Virtual Threads)" style="swimlane;startSize=22;fontStyle=1;align=center;verticalAlign=top;fontSize=10;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="50" y="540" width="1500" height="110" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_22" parent="c_page_1_ecosystem_18" value="&lt;b&gt;Spatial Discovery Engine&lt;/b&gt;&lt;br/&gt;• ST_DWithin physical radius seeks&lt;br/&gt;• ST_Intersects regional polygons&lt;br/&gt;• Left Join shifts (Open Door support)&lt;br/&gt;• ProjectSearchCard projection DTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f97316;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="20" y="30" width="275" height="65" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_23" parent="c_page_1_ecosystem_18" value="&lt;b&gt;Skill &amp; Cause Taxonomies&lt;/b&gt;&lt;br/&gt;• Multi-tag faceted queries (tags/shift_tags)&lt;br/&gt;• Matches David's ESG/GIS skill requirements&lt;br/&gt;• Filters court &amp; SNAP eligibility tags&lt;br/&gt;• Prevents skilled volunteer misallocation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="315" y="30" width="275" height="65" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_24" parent="c_page_1_ecosystem_18" value="&lt;b&gt;Roster &amp; Capacity Engine&lt;/b&gt;&lt;br/&gt;• Automated waitlists &amp; 24h SMS alerts&lt;br/&gt;• Group reservation slots (Chloe's Club)&lt;br/&gt;• Digital parent waivers for youth&lt;br/&gt;• Mitigates Marcus's 35% no-show rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="610" y="30" width="275" height="65" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_25" parent="c_page_1_ecosystem_18" value="&lt;b&gt;Vetting &amp; Safeguarding Gate&lt;/b&gt;&lt;br/&gt;• Background check API status verification&lt;br/&gt;• Prerequisite lock: 40h crisis training&lt;br/&gt;• Protects Dr. Sarah's youth shelters&lt;br/&gt;• Credential expiration tracking alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontSize=9;align=left;spacing=5;fontColor=#6b21a8;fontStyle=1;" vertex="1"><mxGeometry x="905" y="30" width="285" height="65" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_26" parent="c_page_1_ecosystem_18" value="&lt;b&gt;Verification &amp; Audit Engine&lt;/b&gt;&lt;br/&gt;• Official PDF service hour transcripts&lt;br/&gt;• Court-admissible timestamp logs (Raymond)&lt;br/&gt;• 48h scheduled escalation job (Elena)&lt;br/&gt;• Immutable append-only audit ledgers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="1210" y="30" width="270" height="65" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_27" parent="1" value="&lt;b&gt;POSTGRESQL 17 + POSTGIS DATA LAYER&lt;/b&gt; (Fowler's STI + Geodesic Indexing + Transactional Audit Ledgers)" style="swimlane;startSize=22;fontStyle=1;align=center;verticalAlign=top;fontSize=10;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="50" y="660" width="1500" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_28" parent="c_page_1_ecosystem_24" value="&lt;b&gt;projects (STI Aggregate)&lt;/b&gt;&lt;br/&gt;project_type: STANDARD, OPEN_DOOR, REGIONAL&lt;br/&gt;status: DRAFT, PENDING, ACTIVE, FLAGGED&lt;br/&gt;Flags: accepts_court_mandated, snap_eligible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="20" y="30" width="345" height="60" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_29" parent="c_page_1_ecosystem_24" value="&lt;b&gt;Spatial Geometries &amp; Joins&lt;/b&gt;&lt;br/&gt;locations (Point 4326 GiST) + project_locations&lt;br/&gt;boundaries (Polygon 4326 GiST)&lt;br/&gt;Reverse B-Tree index on location_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="385" y="30" width="345" height="60" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_30" parent="c_page_1_ecosystem_24" value="&lt;b&gt;Civic Governance &amp; Escrow&lt;/b&gt;&lt;br/&gt;administrative_regions (Civic Polygons)&lt;br/&gt;region_users (REGION_DIRECTOR / AGENT)&lt;br/&gt;organizations + organization_users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="750" y="30" width="345" height="60" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_31" parent="c_page_1_ecosystem_24" value="&lt;b&gt;Transactional Audit &amp; Hours Ledgers&lt;/b&gt;&lt;br/&gt;project_audit_logs (Immutable append-only)&lt;br/&gt;verified_service_hours (Actor, hours, supervisor)&lt;br/&gt;Foreign keys: actor_id, project_id, shift_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=9;align=left;spacing=5;fontColor=#1e293b;" vertex="1"><mxGeometry x="1115" y="30" width="365" height="60" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_32" parent="1" value="THE FOUR HUMAN VALUE LOOPS &amp; BRIDGING THE DOMAIN CHASM" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1e293b;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="50" y="780" width="500" height="18" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_33" parent="1" value="&lt;b&gt;LOOP 1: SPONTANEOUS PROXIMITY (MAYA)&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Instant Load:&lt;/b&gt; Sub-50ms JTE page render.&lt;br/&gt;2. &lt;b&gt;Truthful Proximity:&lt;/b&gt; ST_DWithin geodesic radius.&lt;br/&gt;3. &lt;b&gt;Zero Friction:&lt;/b&gt; OPEN_DOOR walk-in directions.&lt;br/&gt;4. &lt;b&gt;Verification:&lt;/b&gt; Digital QR attendance &amp; accredited hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1;fontSize=9;align=left;spacing=8;fontColor=#1e293b;" vertex="1"><mxGeometry x="50" y="805" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_34" parent="1" value="&lt;b&gt;LOOP 2: SKILL &amp; PORTFOLIO PIPELINES (DAVID &amp; CHLOE)&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Faceted Search:&lt;/b&gt; Multi-tag query (#gis, #stem, #group).&lt;br/&gt;2. &lt;b&gt;Group Reservations:&lt;/b&gt; Reserving blocks for Key Club.&lt;br/&gt;3. &lt;b&gt;Vetted Passport:&lt;/b&gt; 1-time credential screening.&lt;br/&gt;4. &lt;b&gt;Accreditation:&lt;/b&gt; Official Common App / PDF transcripts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1;fontSize=9;align=left;spacing=8;fontColor=#1e293b;" vertex="1"><mxGeometry x="430" y="805" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_35" parent="1" value="&lt;b&gt;LOOP 3: CAPACITY &amp; COMPLIANCE (MARCUS &amp; RAYMOND)&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Umbrella Projects:&lt;/b&gt; 1 event, 10 distribution hubs.&lt;br/&gt;2. &lt;b&gt;Compliance Match:&lt;/b&gt; Filtering court &amp; SNAP tasks.&lt;br/&gt;3. &lt;b&gt;No-Show Defense:&lt;/b&gt; Automated 24h SMS confirmations.&lt;br/&gt;4. &lt;b&gt;Audit Sign-off:&lt;/b&gt; Timestamped court-admissible logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1;fontSize=9;align=left;spacing=8;fontColor=#1e293b;" vertex="1"><mxGeometry x="810" y="805" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_36" parent="1" value="&lt;b&gt;LOOP 4: DUTY OF CARE &amp; CIVIC GOVERNANCE (SARAH &amp; ELENA)&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Qualification Lock:&lt;/b&gt; Shifts locked until vetted.&lt;br/&gt;2. &lt;b&gt;Containment Routing:&lt;/b&gt; Coordinates routed to region.&lt;br/&gt;3. &lt;b&gt;SLA Guarantee:&lt;/b&gt; 48h partial index auto-escalation.&lt;br/&gt;4. &lt;b&gt;Accountability:&lt;/b&gt; Immutable transaction audit trail." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1;fontSize=9;align=left;spacing=8;fontColor=#1e293b;" vertex="1"><mxGeometry x="1190" y="805" width="360" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_1_ecosystem_37" parent="1" value="&lt;b&gt;STRATEGIC TAKEAWAY:&lt;/b&gt; A complete volunteer management system must handle the full motivational spectrum. From low-barrier spontaneous drop-offs (Maya) and accredited high school club portfolios (Chloe) to court-mandated restitution (Raymond), specialized skill development (David), and trauma-informed safeguarding (Dr. Sarah), Kaiju's architecture unifies these flows under clean API contracts, PostGIS spatial boundaries, and immutable audit ledgers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontColor=#991b1b;fontSize=10;align=left;spacing=8;fontStyle=0;" vertex="1"><mxGeometry x="50" y="955" width="1500" height="50" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_2_maya" name="2. Maya - Spontaneous Local Volunteer">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_2_maya_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: MAYA LIN" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_4" parent="1" value="The Spontaneous Local Volunteer  •  Platform Role: STANDARD_USER / Public Searcher" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#ea580c;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Maya Lin&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The Spontaneous Local Volunteer&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 24 | &lt;b&gt;Occupation:&lt;/b&gt; Marketing Specialist &amp; Part-time Grad Student | &lt;b&gt;Location:&lt;/b&gt; Salt Lake City / Urban Metro | &lt;b&gt;Device:&lt;/b&gt; iPhone 15 (5G/Transit WiFi) | &lt;b&gt;Role:&lt;/b&gt; STANDARD_USER / Public Searcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_10" parent="1" value="Maya recently moved to the city and wants to connect with her neighborhood through weekend volunteering. Between a demanding corporate job and evening graduate classes, her free time is strictly bounded to specific 2-to-3-hour weekend windows. She requires instant mobile discovery without mandatory account creation before seeing project details." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_12" parent="1" value="• Find meaningful community work within a 15-minute bike or transit radius.&lt;br/&gt;• Differentiate between scheduled shifts (soup kitchen) and flexible walk-in drives (clothing donation).&lt;br/&gt;• Obtain verifiable digital proof of service hours for her university degree requirement.&lt;br/&gt;• Arrive with zero ambiguity regarding parking, attire, supplies, and check-in procedure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_14" parent="1" value="• Clunky non-profit websites taking 8+ seconds to load on mobile browsers.&lt;br/&gt;• Being forced to register and submit a 5-page personal profile just to check drop-off hours.&lt;br/&gt;• Arriving at a venue only to discover the event was quietly rescheduled or canceled.&lt;br/&gt;• Inaccurate map pins leading to corporate administrative offices instead of the actual work site." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_16" parent="1" value="• Mobile-first: Discovers events while commuting on transit or scrolling social feeds.&lt;br/&gt;• Low tolerance for high bundle sizes: Abandons pages that freeze or stutter on cellular data.&lt;br/&gt;• Relies on native calendar integrations and SMS/push notifications for shift reminders.&lt;br/&gt;• Expects accurate real-time GPS distance rather than rough county-wide approximations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_21" parent="1" value="&lt;b&gt;MAYA LIN&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;STANDARD_USER / Public Searcher&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f97316;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_23" parent="1" value="&quot;I have three free hours this Saturday morning—is there anything close to me?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_24" parent="1" value="&quot;Can someone officially verify my 20 hours for my university service requirement?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_25" parent="1" value="&quot;Do I need to bring work gloves, or does the organization provide all safety gear?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_26" parent="1" value="&quot;I don't want to create an account with a password just to see what time coat donations are accepted.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_28" parent="1" value="💭 I hope this isn't disorganized like the last cleanup where we stood around for 45 minutes doing nothing." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_29" parent="1" value="💭 Is this neighborhood safe to walk to early on a Saturday morning? Where do I safely park?" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_30" parent="1" value="💭 Will anyone actually notice if I show up, or am I just an extra body in a corner?" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_31" parent="1" value="💭 I really want to help my local community, but I cannot commit to a recurring 6-month contract." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_33" parent="1" value="⚡ Searches for volunteer opportunities on her smartphone while riding transit." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_34" parent="1" value="⚡ Toggles between Google Maps and public transit apps to calculate total travel time." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_35" parent="1" value="⚡ Picks OPEN_DOOR walk-in drives during exam weeks and scheduled shifts when calendar permits." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_36" parent="1" value="⚡ Abandons registration flows immediately if blocked by an aggressive login wall." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_38" parent="1" value="❤️ Eager: Genuinely excited to make an impact and meet neighborhood peers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_39" parent="1" value="❤️ Anxious: Apprehensive about arrival logistics, unfamiliar venues, and parking confusion." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_40" parent="1" value="❤️ Impatient: Irritated by sluggish web interfaces, infinite spinners, and redundant forms." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_41" parent="1" value="❤️ Proud: Uplifted and empowered when her volunteer contribution produces tangible results." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Phantom shifts: Traveling across town only to find a cancelled event or overflowing volunteers.&lt;br/&gt;❌ Sluggish web performance: Multi-megabyte JS bundles freezing mobile browsers on transit.&lt;br/&gt;❌ Inaccurate geocoding: Map pins pointing to mailing addresses rather than active project sites." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Sub-50ms instant browsing: Effortless discovery with zero JavaScript bundle overhead.&lt;br/&gt;✅ Truthful driving distance: Real PostGIS geodesic distance with clear site entry instructions.&lt;br/&gt;✅ Verified digital credential: One-click certified service hour records for school and employer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;JTE Server-Side Views&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Delivers sub-50ms TTFB and 0MB JavaScript bundle weight, allowing Maya to discover projects instantly on cellular transit.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;PostGIS ST_DWithin Radius&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Calculates truthful geodesic distance from Maya's GPS point; prevents fake pins and excludes projects outside her 15-minute radius.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;STI Project Discriminator&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Renders customized UX: 'Get Directions' for OPEN_DOOR coat drives vs. strict calendar shift selection for STANDARD soup kitchens.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_2_maya_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;ProjectSearchCard DTO&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Ultra-lean, immutable JSON projection transferring only essential fields over mobile wire, maximizing battery and data efficiency.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_3_david" name="3. David - Purpose &amp; Skill Volunteer">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_3_david_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: DAVID CHEN" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_4" parent="1" value="The Purpose-Driven &amp; Skill-Building Volunteer  •  Platform Role: STANDARD_USER (Specialist)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;David Chen&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The Purpose-Driven &amp; Skill-Building Volunteer&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 31 | &lt;b&gt;Occupation:&lt;/b&gt; Data Analyst transitioning to ESG &amp; Non-Profit Tech | &lt;b&gt;Location:&lt;/b&gt; Metro Area / Suburban | &lt;b&gt;Device:&lt;/b&gt; MacBook Pro + Pixel Phone | &lt;b&gt;Role:&lt;/b&gt; STANDARD_USER (Specialist / High-Commitment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_10" parent="1" value="David has stable employment and wants to dedicate 5–10 hours every week to causes he is deeply passionate about (wildlife conservation, climate resilience, and youth STEM education). He wants to build real-world leadership experience and apply professional skills (data engineering, GIS mapping, project management) to charitable initiatives. He is completely willing to undergo background checks, attend a 4-hour orientation, and commit to long-term schedules." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_12" parent="1" value="• Filter volunteer opportunities by specific mission cause (#wildlife, #climate) and professional skill requirements (#gis, #data).&lt;br/&gt;• Find long-term, high-impact leadership roles (committee seats, specialized regional projects) rather than one-off general tasks.&lt;br/&gt;• Complete qualification prerequisites (background checks, skill certifications) once and have them recognized across platforms.&lt;br/&gt;• Build a verified portfolio of community technical impact for resume and professional ESG credentialing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_14" parent="1" value="• Offering professional data analysis or GIS expertise to a charity and being assigned to hand out water bottles.&lt;br/&gt;• Search tools that only sort by physical distance, burying regional wildlife initiatives under dozens of neighborhood coat drives.&lt;br/&gt;• Having to re-submit redundant background checks, ID proofs, and reference letters for every individual non-profit.&lt;br/&gt;• Vague project postings that lack clear prerequisite requirements, time commitments, or technical scopes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_16" parent="1" value="• Searches on desktop/laptop where he can read comprehensive project scopes and upload resumes/certifications.&lt;br/&gt;• Evaluates non-profit financial transparency and audit history (Charity Navigator, GuideStar) before committing.&lt;br/&gt;• Uses two-way calendar sync (Google/Outlook) for recurring weekly shift blocks.&lt;br/&gt;• Follows non-profits on LinkedIn and tracks project status updates over months." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0369a1;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_21" parent="1" value="&lt;b&gt;DAVID CHEN&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;STANDARD_USER (Specialist)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_23" parent="1" value="&quot;I have 10 hours a week to give, and I want to use my professional data/GIS skills where they're actually needed.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_24" parent="1" value="&quot;I'm happy to do a background check and complete an orientation—just give me the clear onboarding steps.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_25" parent="1" value="&quot;Why does search only show events 2 miles away? I'll gladly drive 30 miles for an endangered species habitat cleanup.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_26" parent="1" value="&quot;Is there a way to speak with the project director before committing to a 3-month recurring schedule?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_28" parent="1" value="💭 I don't want to waste my Saturdays doing manual busywork that a machine or general volunteer could do in 5 minutes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_29" parent="1" value="💭 If this organization is disorganized during the onboarding process, their field operations will probably be chaotic too." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_30" parent="1" value="💭 I want this service experience on my resume to demonstrate community leadership in clean tech and public data." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_31" parent="1" value="💭 I hope they respect my professional time and don't cancel specialized shifts after I've blocked out my calendar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_33" parent="1" value="⚡ Uses advanced faceted search filters: toggles cause tags (#wildlife, #stem) and skill tags (#gis, #data)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_34" parent="1" value="⚡ Reads organization mission statements and past project audit histories before applying." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_35" parent="1" value="⚡ Uploads professional credentials, clearances, and LinkedIn profile to his volunteer dossier." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_36" parent="1" value="⚡ Commits to recurring weekly schedules or joins REGIONAL initiative waitlists across the county." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_38" parent="1" value="❤️ Purpose-Driven: Deeply compelled by moral mission, environmental stewardship, and community impact." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_39" parent="1" value="❤️ Selective: Unwilling to squander finite professional bandwidth on chaotic, low-impact tasks." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_40" parent="1" value="❤️ Committed: Highly dependable, accountable, and steadfast once aligned with a competent leadership team." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_41" parent="1" value="❤️ Fulfilled: Deeply energized when high-skill contributions transform a non-profit's operational capacity." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Skill underutilization: Being relegated to trivial tasks despite possessing high-demand technical capabilities.&lt;br/&gt;❌ Distance-only search: Distance filters filtering out high-relevance regional initiatives across county borders.&lt;br/&gt;❌ Redundant screening: Repeating background checks and reference interviews for every new organization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Deep skill &amp; cause taxonomy: Fast faceted filtering by required competencies (#gis, #cpr) and causes (#wildlife).&lt;br/&gt;✅ Regional initiative access: Joining geofenced polygon projects (REGIONAL STI) with remote or field components.&lt;br/&gt;✅ Verified credential passport: Reusable digital clearances unlocking specialized, high-trust shifts instantly." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;tags &amp; shift_tags Taxonomy&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Enables multi-tag faceted filtering on skills (#gis, #carpentry) and causes (#wildlife), matching David to high-skill opportunities.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;REGIONAL Project Discriminator&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Bypasses physical point radius limits to surface county/state-wide initiatives that need specialized remote or distributed contributors.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Verified Volunteer Passport (Phase 3/4)&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Stores verified credential badges (background check clearance, CPR license) on users profile to unlock gated shifts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_3_david_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Keyset Scheduled Shifts&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Streams recurring multi-week shift series with sub-millisecond latency for seamless long-term schedule planning.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_4_chloe" name="4. Chloe - Academic &amp; Portfolio Volunteer">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_4_chloe_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: CHLOE TORRES" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_4" parent="1" value="The Academic &amp; Portfolio-Building Student  •  Platform Role: STANDARD_USER (Student / Officer)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;fontColor=#0f766e;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Chloe Torres&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The Academic &amp; Portfolio-Building Student&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 17 | &lt;b&gt;Occupation:&lt;/b&gt; High School Junior &amp; Key Club Philanthropy Officer | &lt;b&gt;Location:&lt;/b&gt; Suburban Metro | &lt;b&gt;Device:&lt;/b&gt; iPhone 14 &amp; School Chromebook | &lt;b&gt;Role:&lt;/b&gt; STANDARD_USER (Student / Club Officer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_10" parent="1" value="Chloe is an ambitious high school student preparing competitive college and scholarship applications. She needs 100 verified service hours for her National Honor Society and diploma seals, and as her school's Key Club officer, she coordinates weekend group service projects for 15–20 classmates. She requires tamper-proof hour logging, digital parent waivers, group slot holds, and an exportable certified service transcript for the Common Application." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_12" parent="1" value="• Earn 100 verified service hours before December scholarship and college application deadlines.&lt;br/&gt;• Reserve blocks of 15–20 volunteer slots for high school club members to attend weekend service projects together.&lt;br/&gt;• Generate an official, tamper-proof PDF service transcript with organization tax IDs and supervisor sign-offs.&lt;br/&gt;• Secure digital endorsements from project directors highlighting her team coordination and leadership." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_14" parent="1" value="• Paper verification forms getting coffee-stained, lost, or rejected by guidance counselors.&lt;br/&gt;• Arriving at a service site with 15 club members only to be told there's only enough work for 5 people.&lt;br/&gt;• Non-profit coordinators taking weeks to sign off on hours when scholarship submission deadlines are days away.&lt;br/&gt;• Underage students needing physical paper permission slips signed by parents because platforms lack digital minor consent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_16" parent="1" value="• Mobile-native: Lives on Instagram, TikTok, and Google Classroom; expects smooth, modern mobile UX.&lt;br/&gt;• Organizes group signups via shared spreadsheets and group chat invite links.&lt;br/&gt;• Values gamified progress trackers and milestone badges (e.g., '50 Hours Bronze Milestone').&lt;br/&gt;• Needs 1-click cloud export of PDF documents directly to school portals or email." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_21" parent="1" value="&lt;b&gt;CHLOE TORRES&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;STANDARD_USER (Student / Officer)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0d9488;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_23" parent="1" value="&quot;I need to log 100 verified community service hours by December for my early college application.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_24" parent="1" value="&quot;Can I reserve 15 spots for our high school Key Club to volunteer together this Saturday?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_25" parent="1" value="&quot;Does your app generate an official letter with the supervisor's signature and contact number?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_26" parent="1" value="&quot;Do my parents have to sign a physical paper slip, or is there a digital waiver link I can text them?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_28" parent="1" value="💭 If this non-profit doesn't verify my hours before the deadline, all my weekend work won't count on my application." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_29" parent="1" value="💭 I hope our club members actually show up so I don't look unreliable in front of the volunteer coordinator." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_30" parent="1" value="💭 I want to do real leadership work that looks impressive on my college resume, not just hand out flyers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_31" parent="1" value="💭 I need an easy way to export an official service transcript to upload directly to the Common App." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_33" parent="1" value="⚡ Filters projects for weekend group availability and student-friendly physical requirements." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_34" parent="1" value="⚡ Reserves shift blocks for her club peers and distributes join tokens through club messaging channels." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_35" parent="1" value="⚡ Dispatches digital parental consent links to underage students prior to event day." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_36" parent="1" value="⚡ Scans on-site QR codes for check-in and immediately requests supervisor verification at shift end." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_38" parent="1" value="❤️ Ambitious: Highly driven to achieve scholarship milestones and build an impressive civic portfolio." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_39" parent="1" value="❤️ Anxious: Stressed about tight application deadlines and chasing down slow supervisor signatures." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_40" parent="1" value="❤️ Accountable: Feels strong peer pressure to deliver organized, safe service opportunities for her club." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_41" parent="1" value="❤️ Proud: Uplifted and validated when her certified transcript reaches the 100-hour achievement tier." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Lost paper records: Paper logs misplaced by counselors or organizers destroying months of documented service.&lt;br/&gt;❌ Group booking gaps: Having to ask 15 teenagers to individually sign up before slots fill up.&lt;br/&gt;❌ Delayed verification: Non-profits taking weeks to confirm hours, causing students to miss scholarship deadlines." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Digital service transcript: Instant export of certified, tamper-proof service records for college portals.&lt;br/&gt;✅ Group reservation holds: Reserving slot blocks with shareable invite tokens for student clubs.&lt;br/&gt;✅ Digital minor consent: Automated parental e-signatures eliminating physical paper slips." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Verified Hours Ledger&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Database schema stores exact verified hours, supervisor actor ID, and organization 501(c)(3) EIN for accredited reporting.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Group Reservation Engine&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Allows club leaders like Chloe to hold blocks of slots with temporary reservation tokens for student peers.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Digital Minor Waiver Pipeline&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Automated guardian SMS/email waiver signing satisfying COPPA and non-profit liability rules.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_4_chloe_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;PDF Transcript Generator&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Generates verifiable PDF completion certificates with unique cryptographic validation URLs for university admissions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_5_raymond" name="5. Raymond - Mandated &amp; Compliance Volunteer">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_5_raymond_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: RAYMOND MILLER" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_4" parent="1" value="The Compliance &amp; Mandated Service Volunteer  •  Platform Role: STANDARD_USER (Court / SNAP)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;fontColor=#a16207;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Raymond Miller&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The Compliance &amp; Mandated Service Volunteer&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 35 | &lt;b&gt;Occupation:&lt;/b&gt; Hourly Warehouse Worker &amp; Community Service Participant | &lt;b&gt;Location:&lt;/b&gt; Urban Center | &lt;b&gt;Device:&lt;/b&gt; Android Smartphone (Prepaid Cellular) | &lt;b&gt;Role:&lt;/b&gt; STANDARD_USER (Court / SNAP Mandated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_10" parent="1" value="Raymond is an hourly warehouse employee balancing a 40-hour court-ordered community restitution requirement (traffic diversion) with monthly 20-hour SNAP ABAWD work requirements. He relies on public bus transit and hourly wages, meaning he cannot miss work and must find flexible evening or weekend community service. His freedom and nutritional benefits depend on strictly compliant, tamper-proof, court-admissible service documentation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_12" parent="1" value="• Complete 40 court-ordered hours before his probation compliance hearing on the 30th of the month.&lt;br/&gt;• Fulfill 20 monthly community service hours to satisfy SNAP ABAWD work requirements and maintain food assistance.&lt;br/&gt;• Find flexible evening and Sunday shifts that do not conflict with hourly wage-earning employment.&lt;br/&gt;• Obtain tamper-proof, supervisor-signed logs with exact timestamps and non-profit EINs for court officers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_14" parent="1" value="• Traveling 45 minutes on the bus only to be told on arrival: 'We do not accept court-mandated volunteers.'&lt;br/&gt;• Probation officers rejecting paper logs due to messy handwriting, missing supervisor phone numbers, or lack of EINs.&lt;br/&gt;• Delayed verification causing SNAP benefits to lapse, resulting in sudden food insecurity for his household.&lt;br/&gt;• Facing humiliating judgment or intrusive questions about his offense when signing up for community initiatives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_16" parent="1" value="• Relies heavily on SMS text updates and mobile browser access; visits public libraries for document printing.&lt;br/&gt;• Monitors hours balance obsessively; needs an unambiguous countdown to legal and benefits compliance.&lt;br/&gt;• Prioritizes tasks with immediate on-site electronic confirmation over delayed administrative sign-offs.&lt;br/&gt;• Values privacy and discretion regarding his legal and assistance status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#a16207;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_21" parent="1" value="&lt;b&gt;RAYMOND MILLER&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;STANDARD_USER (Court / SNAP)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_23" parent="1" value="&quot;Does your organization explicitly accept court-ordered community service and SNAP work requirements?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_24" parent="1" value="&quot;I have to submit this signed log to my probation officer by the 30th or I face a court hearing.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_25" parent="1" value="&quot;Do you have any evening or Sunday shifts so I don't have to miss my paid warehouse job?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_26" parent="1" value="&quot;Can the supervisor sign off on my hours right at 4:00 PM before I catch the cross-town bus?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_28" parent="1" value="💭 If I lose this food assistance or miss my court hours, my whole family will suffer." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_29" parent="1" value="💭 I feel judged when people ask why I'm volunteering; I just want to do honest hard work and clear my record." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_30" parent="1" value="💭 I hope the probation officer accepts this digital report without demanding a wet-ink rubber stamp." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_31" parent="1" value="💭 I can't afford to waste bus fare traveling to a site that turns me away at the door." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_33" parent="1" value="⚡ Filters specifically for projects flagged with accepts_court_mandated = TRUE and snap_eligible = TRUE." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_34" parent="1" value="⚡ Prioritizes physical tasks (warehouse packing, trail clearing, sorting) that have no disqualifying restrictions." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_35" parent="1" value="⚡ Uses GPS check-in/out on mobile to establish an immutable, verifiable electronic timestamp." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_36" parent="1" value="⚡ Generates certified compliance reports directly from the app to show his probation officer and caseworker." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_38" parent="1" value="❤️ Pressured: Constantly aware of legal deadlines and the severe consequences of non-compliance." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_39" parent="1" value="❤️ Vulnerable: Afraid of bureaucratic delays causing benefit termination or probation revocation." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_40" parent="1" value="❤️ Dignified: Proud of doing genuine, productive hard work to repay his civic obligation." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_41" parent="1" value="❤️ Relieved: Deeply grateful when verified hours are logged cleanly and court requirements are fulfilled." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Rejection at venue: Being turned away at the door because an organization silently bars court-mandated volunteers.&lt;br/&gt;❌ Probation non-compliance: Paper logs rejected for formatting technicalities, risking bench warrants or fines.&lt;br/&gt;❌ Benefit lapses: Delays in monthly hour reporting causing SNAP food assistance to be abruptly suspended." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Compliance search filter: Clear visibility into court-approved and SNAP-eligible non-profit opportunities.&lt;br/&gt;✅ GPS-verified check-in: Incontestable timestamped attendance logs with supervisor verification IDs.&lt;br/&gt;✅ Court-admissible reports: Official PDF summaries with organization tax IDs and verification tokens for judges." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Compliance Attribute Flags&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Database schema flags (accepts_court_mandated, snap_work_eligible) on projects prevent wasted bus trips and rejection.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Tamper-Proof Audit Logging&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;project_audit_logs captures exact GPS geofenced check-in/out timestamps and supervisor actor IDs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Court-Admissible PDF Export&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Generates standardized official compliance documents with organization EIN, supervisor phone, and verification QR codes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_5_raymond_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Flexible Keyset Shift Schedules&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Filters for evening and weekend shift series, allowing hourly wage earners to fulfill hours without missing paid shifts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_6_marcus" name="6. Marcus - High-Volume Coordinator">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_6_marcus_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: MARCUS VANCE" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_4" parent="1" value="The High-Volume Operations Coordinator  •  Platform Role: ORG_ADMIN / ORG_MANAGER" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#059669;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Marcus Vance&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The High-Volume Operations Coordinator&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 38 | &lt;b&gt;Occupation:&lt;/b&gt; Volunteer Operations Coordinator (Metro Food Relief) | &lt;b&gt;Location:&lt;/b&gt; County Regional Headquarters | &lt;b&gt;Device:&lt;/b&gt; Dual-Monitor Desktop &amp; iPad Field Tablet | &lt;b&gt;Role:&lt;/b&gt; ORG_ADMIN / ORG_MANAGER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_10" parent="1" value="Marcus manages volunteer logistics for a metropolitan food rescue and urban agriculture non-profit. He coordinates over 600 monthly volunteer slots across 5 physical distribution warehouses and seasonal farm sites. Operating with minimal administrative staff, he spends excessive hours re-entering data between clipboards, spreadsheets, and municipal permits while battling a frustrating 30–50% volunteer no-show rate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_12" parent="1" value="• Fill 100% of shift capacity for critical assembly lines (e.g. Saturday emergency food boxes).&lt;br/&gt;• Eliminate the chronic 35% volunteer no-show rate through automated waitlists and reminders.&lt;br/&gt;• Manage multi-site initiatives under a single umbrella project without cloning identical records.&lt;br/&gt;• Maintain digital records of signed liability waivers and emergency contacts to shield the non-profit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_14" parent="1" value="• Volunteers RSVPing weeks in advance and ghosting on Saturday morning, starving packaging lines.&lt;br/&gt;• Spreadsheet desynchronization between office coordinators and on-site warehouse managers.&lt;br/&gt;• Re-typing the same project description, safety rules, and requirements 10 times for 10 distribution hubs.&lt;br/&gt;• Spending hours manually generating PDF service verification letters for high school students." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_16" parent="1" value="• Desktop power-user in the office: Needs multi-pane shift calendars, bulk tables, and keyboard shortcuts.&lt;br/&gt;• Field tablet user on-site: Requires offline-capable roster check-ins and quick contact lookups.&lt;br/&gt;• Relies on batch CSV imports/exports to sync with donor management and grant reporting platforms.&lt;br/&gt;• Avoids clunky web tools that lack bulk editing or require 5 clicks to update a single shift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_21" parent="1" value="&lt;b&gt;MARCUS VANCE&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;ORG_ADMIN / ORG_MANAGER&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_23" parent="1" value="&quot;We need 15 volunteers at 7:00 AM to pack 400 food boxes, but 6 just sent last-minute cancellations.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_24" parent="1" value="&quot;Why do I have to re-enter this project 5 times for our 5 different distribution hubs?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_25" parent="1" value="&quot;I spend half my Monday transcribing illegible handwriting from sign-in clipboards into Excel.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_26" parent="1" value="&quot;Do we have a signed digital liability waiver on file for that volunteer operating the pallet jack?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_28" parent="1" value="💭 If volunteers don't show up on Saturday morning, vulnerable families don't get food boxes this week." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_29" parent="1" value="💭 I got into non-profit work to serve my community, but 70% of my time is spent on clerical data entry." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_30" parent="1" value="💭 I hope our regional moderation approval doesn't get stuck in civic review limbo before this weekend's drive." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_31" parent="1" value="💭 We desperately need a core cohort of vetted regulars rather than an endless churn of one-off tourists." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_33" parent="1" value="⚡ Creates and manages multi-site projects from his desktop workstation at regional headquarters." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_34" parent="1" value="⚡ Sends frantic reminder SMS messages from his personal phone on Friday afternoon to confirm attendance." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_35" parent="1" value="⚡ Uses paper clipboards and sign-in sheets at warehouse entry doors during morning rush." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_36" parent="1" value="⚡ Manually signs and emails volunteer hour completion letters to school counselors and probation officers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_38" parent="1" value="❤️ Chronically Overwhelmed: Constantly buried under administrative repetition, roster churn, and spreadsheets." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_39" parent="1" value="❤️ Anxious: Stressed on event mornings about shift capacity shortfalls and critical assembly bottlenecks." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_40" parent="1" value="❤️ Protective: Passionately committed to organizational liability compliance and volunteer physical safety." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_41" parent="1" value="❤️ Mission-Driven: Deeply gratified when distribution lines run smoothly and food reaches community members." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ 30–50% No-show rates: Chronic volunteer absenteeism crippling physical warehouse and harvest operations.&lt;br/&gt;❌ Duplicate data entry: Redundant project cloning across multiple physical addresses and distribution nodes.&lt;br/&gt;❌ Liability vulnerability: Paper waivers lost or misplaced, risking catastrophic liability in injury claims." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Automated waitlist backfill: Real-time promotion of standby volunteers when cancellations occur.&lt;br/&gt;✅ 1-to-Many project locations: Creating one umbrella project linked to multiple physical locations.&lt;br/&gt;✅ Digital roster check-in: QR scanning and geofenced check-in eliminating paper clipboard transcription." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Compose Multiplatform Admin&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Provides Marcus with desktop-grade shift builders, drag-and-drop calendars, and batch roster tables without web UI lag.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;project_locations Bridge&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Enables Marcus to link 1 umbrella food drive to 10 physical distribution hubs, eliminating duplicate project cloning.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;/no-look Ingestion Endpoints&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Bypasses redundant pre-flight existsById checks, allowing Marcus to sync 500+ shift slots from external systems in seconds.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_6_marcus_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Verified Status Bypass&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Once Marcus's organization achieves VERIFIED status, his project updates publish instantly without waiting for moderation queues.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_7_sarah" name="7. Dr. Sarah - Specialized Director">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_7_sarah_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: DR. SARAH AL-MANSOOR" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_4" parent="1" value="The High-Liability &amp; Safeguarding Director  •  Platform Role: ORG_ADMIN (Youth/Crisis)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#9333ea;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Dr. Sarah Al-Mansoor&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The High-Liability &amp; Safeguarding Director&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 42 | &lt;b&gt;Occupation:&lt;/b&gt; Program Director (Youth Horizons &amp; Crisis Intervention) | &lt;b&gt;Location:&lt;/b&gt; Metropolitan Youth Center | &lt;b&gt;Device:&lt;/b&gt; Secure Workstation &amp; Encrypted Laptop | &lt;b&gt;Role:&lt;/b&gt; ORG_ADMIN (High-Liability / Vetting-Intensive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_10" parent="1" value="Dr. Sarah oversees court-mandated youth mentoring, transitional foster youth programs, and a 24/7 crisis support line. Her programs involve direct contact with vulnerable minors and individuals in trauma. She faces strict legal mandates (state child protection laws, HIPAA/privacy rules, liability insurance) and cannot permit unvetted public sign-ups. She requires rigorous screening, background check tracking, and certified training verifications before shift booking is unlocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_12" parent="1" value="• Enforce mandatory qualification gates (FBI/DOJ background check, 40h crisis training) before any volunteer accesses shifts.&lt;br/&gt;• Track expiration dates of background clearances and professional licenses automatically with zero compliance lapses.&lt;br/&gt;• Manage a structured onboarding pipeline: Application -&gt; Background Check -&gt; Training -&gt; Supervised Shift -&gt; Qualified Roster.&lt;br/&gt;• Maintain an immutable, audit-ready compliance ledger of every volunteer's credentials, supervisor approvals, and client contact hours." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_14" parent="1" value="• Public platforms allowing unvetted walk-ins to self-register for sensitive youth or shelter shifts without screening.&lt;br/&gt;• Tracking background check renewal dates across 150 volunteers in messy spreadsheets, creating extreme liability risk.&lt;br/&gt;• High drop-out rates midway through the 40-hour training curriculum, wasting hundreds of dollars in non-profit vetting fees.&lt;br/&gt;• Lack of granular permissions to restrict sensitive case notes and client addresses from general volunteers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_16" parent="1" value="• Strict compliance &amp; security mindset: Requires role-based access control (RBAC), multi-factor auth, and data encryption.&lt;br/&gt;• Integrates with professional screening APIs (e.g. Checkr, Sterling, state LiveScan portals) for automated clearance updates.&lt;br/&gt;• Uses tiered volunteer permissions (ONBOARDING, PROVISIONAL, VETTED_LEAD) to gate shift booking.&lt;br/&gt;• Audits volunteer rosters monthly for grant compliance and accreditation reviews." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_21" parent="1" value="&lt;b&gt;DR. SARAH AL-MANSOOR&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;ORG_ADMIN (Youth/Crisis)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_23" parent="1" value="&quot;We cannot legally permit a volunteer near our youth facility without an active, verified criminal background check.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_24" parent="1" value="&quot;I need to know which volunteers completed the 40-hour trauma-informed crisis training before scheduling them.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_25" parent="1" value="&quot;Why did this platform let an unvetted user sign up for a night shelter shift?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_26" parent="1" value="&quot;Our grant funding requires an audited log of every volunteer's credentials and supervised contact hours.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_28" parent="1" value="💭 A single safeguarding failure or unvetted individual could cause catastrophic harm to a child and destroy our mission." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_29" parent="1" value="💭 I feel guilty turning away eager people, but our duty of care to vulnerable clients must always come first." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_30" parent="1" value="💭 I waste thousands of dollars in background check fees on volunteers who ghost us during training." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_31" parent="1" value="💭 I need an automated system that locks shifts until all credentials, trainings, and waivers are verified." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_33" parent="1" value="⚡ Sets project security prerequisites: toggles 'requires_background_check = TRUE' and 'min_training_hours = 40'." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_34" parent="1" value="⚡ Reviews candidate application dossiers, references, and digital identity verifications in admin portal." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_35" parent="1" value="⚡ Monitors credential expiration dashboards to alert volunteers 60 days before their background check expires." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_36" parent="1" value="⚡ Locks shift self-registration behind private or gated qualification rosters." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_38" parent="1" value="❤️ Vigilant: Hyper-aware of legal liability, youth safeguarding, and institutional compliance." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_39" parent="1" value="❤️ Protective: Fiercely devoted to shielding trauma survivors and minors from physical or emotional harm." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_40" parent="1" value="❤️ Cautious: Skeptical of 'instant sign-up' features that sacrifice safety for user acquisition metrics." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_41" parent="1" value="❤️ Relieved: Deeply reassured when technical guardrails guarantee that only 100% vetted volunteers access shifts." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Safeguarding breach risk: Unauthorized or unvetted individuals gaining access to vulnerable populations.&lt;br/&gt;❌ Expired credential blind spots: Volunteers working with lapsed background checks or certifications.&lt;br/&gt;❌ Wasted screening capital: Paying expensive background check fees for flaky volunteers who abandon the program." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Automated qualification gating: Shifts automatically locked until background checks and training are certified.&lt;br/&gt;✅ Integrated screening pipeline: Direct API verification of background clearances and identity records.&lt;br/&gt;✅ Audit-ready compliance reports: 1-click export of tamper-proof credential logs for grant and legal authorities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Gated Roster State Machine&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Shifts evaluate volunteer qualification state (status = QUALIFIED) before allowing sign-up transactions, preventing unvetted access.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Micronaut Security &amp; RBAC&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Enforces strict tiered permissions across ORG_ADMIN, ORG_MANAGER, and verified volunteer role claims.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Credential Expiration Tracking&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Database schema stores certification expiration dates, triggering automated alerts before clearances lapse.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_7_sarah_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;Transactional Audit Ledgers&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Immutable append-only ledger logs every background approval, waiver e-signature, and supervised hour for grant audits.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_8_elena" name="8. Elena - Civic Regional Moderator">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c_page_8_elena_2" parent="1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="20" y="20" width="1560" height="1110" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_3" parent="1" value="PROTO-PERSONA &amp; NN/g EMPATHY MAP: ELENA ROSTOVA" style="text;html=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontSize=20;fontStyle=1;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="35" width="850" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_4" parent="1" value="The Civic Regional Moderator  •  Platform Role: REGION_DIRECTOR / REGION_AGENT" style="text;html=1;align=left;verticalAlign=middle;fontColor=#475569;fontSize=13;fontFamily=Helvetica;" vertex="1"><mxGeometry x="50" y="63" width="850" height="22" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_5" parent="1" value="NN/g Best Practice: 4 Quadrants (Says, Thinks, Does, Feels) + Pains &amp; Gains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1d4ed8;fontSize=11;fontStyle=1;arcSize=20;" vertex="1"><mxGeometry x="1030" y="40" width="510" height="28" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_6" parent="1" value="KAIJU ARCHITECTURE ALIGNMENT: Mapping Human Empathy directly to Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=11;fontStyle=0;arcSize=20;" vertex="1"><mxGeometry x="1030" y="72" width="510" height="24" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_7" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="50" y="110" width="450" height="1000" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_8" parent="1" value="&lt;b&gt;&lt;font size='4'&gt;Elena Rostova&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color='#64748b'&gt;The Civic Regional Moderator&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Age:&lt;/b&gt; 45 | &lt;b&gt;Occupation:&lt;/b&gt; County Director of Civic Engagement &amp; Public Safety | &lt;b&gt;Location:&lt;/b&gt; County Government Center | &lt;b&gt;Device:&lt;/b&gt; Government Workstation (Dual Display &amp; GIS Terminal) | &lt;b&gt;Role:&lt;/b&gt; REGION_DIRECTOR / REGION_AGENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;align=left;spacing=12;fontSize=11;fontColor=#0f172a;arcSize=10;" vertex="1"><mxGeometry x="65" y="125" width="420" height="85" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_9" parent="1" value="&lt;b&gt;BIO &amp; CONTEXT&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="225" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_10" parent="1" value="Elena oversees municipal volunteer services, community engagement initiatives, and public safety vetting across a regional jurisdiction covering four municipalities. She is legally responsible for ensuring that all published volunteer opportunities adhere to municipal safety codes, insurance requirements, and non-profit validity. She must balance thorough civic oversight with strict 48-hour SLA turnaround times to avoid stalling grassroots initiatives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="247" width="420" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_11" parent="1" value="&lt;b&gt;NEEDS &amp; CORE GOALS&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="362" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_12" parent="1" value="• Safeguard public trust by intercepting fraudulent projects, commercial marketing scams, or hazardous tasks.&lt;br/&gt;• Clear all pending regional project reviews within the mandatory 48-hour SLA window.&lt;br/&gt;• Ensure regional boundaries are strictly respected so emergency services and municipal liability are clear.&lt;br/&gt;• Maintain an immutable, court-admissible audit trail of all project approvals, rejections, and revisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="384" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_13" parent="1" value="&lt;b&gt;FRUSTRATIONS &amp; OBSTACLES&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="529" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_14" parent="1" value="• Vague project submissions missing basic safety protocols, insurance proof, or accurate physical coordinates.&lt;br/&gt;• Grassroots organizers making unauthorized edits to project descriptions *after* civic approval has been granted.&lt;br/&gt;• Submissions straddling municipal boundaries creating confusion over emergency service jurisdictions.&lt;br/&gt;• Review queue bottlenecks during peak disaster relief or holiday seasons threatening 48-hour SLA compliance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#991b1b;" vertex="1"><mxGeometry x="65" y="551" width="420" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_15" parent="1" value="&lt;b&gt;TECH HABITS &amp; MENTAL MODEL&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="696" width="420" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_16" parent="1" value="• GIS Power User: Requires layered map visualizations (parcels, municipal boundaries, flood zones).&lt;br/&gt;• Audit-Centric: Inspects historical logs, timestamp diffs, and actor IDs before signing off on approvals.&lt;br/&gt;• Strict Workflow Compliance: Relies on automated escalation queues and notifications to manage pending workloads.&lt;br/&gt;• Security Conscious: Enforces strict Role-Based Access Control (RBAC) to ensure moderators do not exceed authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontColor=#334155;" vertex="1"><mxGeometry x="65" y="718" width="420" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_17" parent="1" value="&lt;b&gt;STRATEGIC IMPLICATION FOR KAIJU&lt;/b&gt;&lt;br/&gt;The system must adapt to this user's specific friction tolerance and commitment level, providing appropriate technical guardrails without causing abandonment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#0f172a;" vertex="1"><mxGeometry x="65" y="853" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_18" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="110" width="1020" height="670" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_19" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=south;" vertex="1"><mxGeometry x="1030" y="130" width="10" height="630" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_20" parent="1" value="" style="line;strokeWidth=2;strokeColor=#e2e8f0;direction=east;" vertex="1"><mxGeometry x="540" y="445" width="980" height="10" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_21" parent="1" value="&lt;b&gt;ELENA ROSTOVA&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;REGION_DIRECTOR / REGION_AGENT&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=3;fontColor=#0f172a;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;shadow=1;" vertex="1"><mxGeometry x="940" y="405" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_22" parent="1" value="&lt;b&gt;1. SAYS (Explicit Verbal Expressions &amp; Quotes)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What the user vocalizes out loud to peers, organizers, or support&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#0284c7;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_23" parent="1" value="&quot;Does this volunteer stream restoration project have clearance to dig near municipal storm drains?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_24" parent="1" value="&quot;This event borders two municipalities; which city's emergency response is designated if an injury occurs?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_25" parent="1" value="&quot;I have 8 projects in the queue that will auto-escalate to the state level in 6 hours if I don't triage them.&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="545" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_26" parent="1" value="&quot;Who modified the youth safety requirements on this construction build after we already approved it?&quot;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e0f2fe;strokeColor=#38bdf8;fontColor=#0369a1;fontSize=10;align=left;spacing=8;fontStyle=2;" vertex="1"><mxGeometry x="775" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_27" parent="1" value="&lt;b&gt;2. THINKS (Unspoken Beliefs, Anxieties &amp; Doubts)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What occupies the user's mind that they hesitate to voice publicly&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#7c3aed;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="125" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_28" parent="1" value="💭 If an unvetted group runs a hazardous project and a citizen gets injured, the city and platform bear liability." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_29" parent="1" value="💭 I don't want to be the bureaucratic bottleneck holding back passionate neighborhood volunteers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="165" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_30" parent="1" value="💭 Is this project truly a public charity initiative, or is a private commercial business seeking free labor?" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_31" parent="1" value="💭 I need clear, binding PostGIS polygon containment checks, not vague text descriptions of service territories." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ede9fe;strokeColor=#a78bfa;fontColor=#5b21b6;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="285" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_32" parent="1" value="&lt;b&gt;3. DOES (Observable Physical Behaviors &amp; Actions)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;What concrete steps, workarounds, and habits the user performs&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#d97706;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="545" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_33" parent="1" value="⚡ Logs into the regional moderation portal every morning to inspect incoming pending submissions." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_34" parent="1" value="⚡ Cross-references submitted boundary polygons against municipal administrative boundaries in GIS viewers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_35" parent="1" value="⚡ Verifies IRS non-profit determination letters and organization verification statuses." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="545" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_36" parent="1" value="⚡ Triggers administrative re-reviews whenever flagged projects submit material description or location changes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#fbbf24;fontColor=#92400e;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="775" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_37" parent="1" value="&lt;b&gt;4. FEELS (Emotional States, Anxieties &amp; Triumphs)&lt;/b&gt;&lt;br/&gt;&lt;font size='1' color='#64748b'&gt;The affective feelings, highs, lows, and cognitive fatigue&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontColor=#db2777;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="1055" y="470" width="450" height="30" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_38" parent="1" value="❤️ Accountable: Strongly weighs the legal, ethical, and public safety responsibilities of municipal governance." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_39" parent="1" value="❤️ Pressured: Constantly aware of the ticking 48-hour SLA escalation clock and heavy seasonal volume." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="505" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_40" parent="1" value="❤️ Vigilant: Skeptical of ambiguous descriptions, missing safety precautions, and unverified organizations." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1055" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_41" parent="1" value="❤️ Gratified: Proud when well-governed civic volunteer initiatives mobilize hundreds of residents safely." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;align=left;spacing=8;" vertex="1"><mxGeometry x="1285" y="620" width="215" height="105" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_42" parent="1" value="&lt;b&gt;CRITICAL PAINS &amp; RISKS:&lt;/b&gt;&lt;br/&gt;❌ Boundary ambiguity: Cross-jurisdictional projects lacking clear municipal liability boundaries.&lt;br/&gt;❌ Stealth edits: Organizers altering project scope post-approval without triggering municipal re-review.&lt;br/&gt;❌ SLA queue bottlenecks: Ticking 48-hour escalation timers causing operational stress and review backlogs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#991b1b;" vertex="1"><mxGeometry x="520" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_43" parent="1" value="&lt;b&gt;DESIRED GAINS &amp; SUCCESS METRICS:&lt;/b&gt;&lt;br/&gt;✅ Automated spatial routing: PostGIS boundary intersection automatically assigning projects to correct region.&lt;br/&gt;✅ Immutable audit trails: Append-only transaction records capturing actor, timestamp, and status diff.&lt;br/&gt;✅ Automated 48h escalation: Scheduled partial index job escalating stalled projects without manual tracking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#065f46;" vertex="1"><mxGeometry x="1045" y="795" width="495" height="135" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_44" parent="1" value="&lt;b&gt;KAIJU TECH STACK ALIGNMENT &amp; ARCHITECTURAL SOLUTION&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#0f172a;" vertex="1"><mxGeometry x="520" y="940" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_45" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;strokeWidth=1;" vertex="1"><mxGeometry x="520" y="965" width="1020" height="145" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_46" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;administrative_regions (DDD)&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Separates civic governance authority from operational project boundaries, preserving municipal jurisdiction integrity.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="530" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_47" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;48h Escalation Queue&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Partial index (idx_projects_pending_escalation) backs an hourly background job that auto-escalates stalled reviews to parent region.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="782" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_48" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;PENDING_UPDATE State Machine&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Material edits by non-admin organizers automatically flip status to PENDING_UPDATE, preventing unapproved changes to live events.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1034" y="975" width="242" height="125" as="geometry"/></mxCell>
        <mxCell id="c_page_8_elena_49" parent="1" value="&lt;b&gt;&lt;font color='#38bdf8'&gt;project_audit_logs Ledger&lt;/font&gt;&lt;/b&gt;&lt;hr style='border-color:#334155;margin:4px 0;'/&gt;&lt;font color='#e2e8f0'&gt;Immutable append-only ledger recording every CREATED, APPROVED, REJECTED, and EDITED state transition with actor ID.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontSize=10;align=left;verticalAlign=top;spacing=8;fontColor=#ffffff;" vertex="1"><mxGeometry x="1286" y="975" width="242" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>